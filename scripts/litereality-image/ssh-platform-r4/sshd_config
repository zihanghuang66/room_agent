# Use the normal system config so school provisioning can edit it.
Include /run/room-ssh-port.conf
Include /etc/ssh/sshd_config.d/*.conf
# OpenSSH defaults to port 22 unless the platform or ROOM_SSH_PORT overrides it.
PubkeyAuthentication yes
AuthorizedKeysFile .ssh/authorized_keys
PasswordAuthentication yes
KbdInteractiveAuthentication no
PermitEmptyPasswords no
PermitRootLogin yes
UsePAM yes
X11Forwarding no
PrintMotd no
AcceptEnv LANG LC_* COLORTERM TERM_PROGRAM TERM_PROGRAM_VERSION
Subsystem sftp internal-sftp
TCPKeepAlive yes
ClientAliveInterval 60
ClientAliveCountMax 3600
