# Compile on CPU build workers with nvcc; no nvidia-smi or GPU allocation needed for compilation.
# These targets cover A100, RTX 3090 and RTX 4090. Runtime GPU operations are checked separately.
ARG CUDA_ARCH_LIST="8.0;8.6;8.9+PTX"
ARG BUILD_JOBS=2
ENV TORCH_CUDA_ARCH_LIST=${CUDA_ARCH_LIST} MAX_JOBS=${BUILD_JOBS}
RUN python3.10 /opt/room/image/install.py native trellis
RUN python3.10 /opt/room/image/install.py native utils3d
