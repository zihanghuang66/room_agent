# Room LiteReality-Agent environment recipe v0.1.3, linux/amd64.
# Standalone Dockerfile: no COPY/ADD, local archives or credentials required.
# Embedded scripts are available in the companion review bundle.
# Build is NOT an end-to-end scene validation. Run room-check after GPU allocation.
ARG BASE_IMAGE=10.27.130.24:5000/pytorch/pytorch-admin:24.06-py3
FROM ${BASE_IMAGE}
USER root
SHELL ["/bin/bash", "-o", "pipefail", "-c"]
RUN set -eu; cat /etc/os-release; \
    test "$(uname -m)" = x86_64; . /etc/os-release; \
    if [ "$ID" != ubuntu ] || [ "$VERSION_ID" != 22.04 ]; then \
      echo 'ERROR: This school-image adaptation requires Ubuntu 22.04 x86_64. Return this build log.' >&2; exit 1; \
    fi; \
    mkdir -p /opt/room/build-info; cat /etc/os-release > /opt/room/build-info/base-os-release.txt; \
    if [ -x /usr/local/cuda/bin/nvcc ]; then /usr/local/cuda/bin/nvcc --version | tee /opt/room/build-info/base-nvcc.txt; fi
LABEL org.opencontainers.image.title="Room LiteReality-Agent" \
      org.opencontainers.image.version="0.1.2" \
      org.opencontainers.image.description="Pinned Codex adapter, Blender and local DINO/TRELLIS environment; GPU runtime validation required"
ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONUNBUFFERED=1 PYTHONNOUSERSITE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 UV_NO_CACHE=1 UV_NO_CONFIG=1 UV_PYTHON_DOWNLOADS=never UV_HTTP_TIMEOUT=120 \
    CUDA_HOME=/usr/local/cuda-12.4 \
    PATH=/opt/room/bootstrap/bin:/opt/room/bin:/usr/local/cuda-12.4/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    PYTHONPATH="" VIRTUAL_ENV="" PIP_CONSTRAINT="" PIP_BUILD_CONSTRAINT="" \
    LD_LIBRARY_PATH=/usr/local/nvidia/lib:/usr/local/nvidia/lib64
RUN test "$(uname -m)" = x86_64 && \
    sed -i -e 's|http://archive.ubuntu.com/ubuntu|https://mirrors.tuna.tsinghua.edu.cn/ubuntu|g' \
           -e 's|http://security.ubuntu.com/ubuntu|https://mirrors.tuna.tsinghua.edu.cn/ubuntu|g' /etc/apt/sources.list && \
    apt-get -o Acquire::Retries=3 -o Acquire::http::Timeout=60 -o Acquire::https::Timeout=60 update && apt-get install -y --no-install-recommends \
      ca-certificates curl git git-lfs xz-utils unzip bzip2 tini ripgrep \
      openssh-client openssh-server tmux zsh rsync vim-tiny nano less htop jq \
      procps iproute2 iputils-ping dnsutils ncurses-bin ncurses-term locales \
      build-essential cmake pkg-config ffmpeg python3.10 python3.10-dev python3.10-venv python3-pip \
      libjpeg-dev zlib1g-dev libpng-dev libwebp-dev libegl1 libegl-mesa0 libegl1-mesa-dev \
      libgl1 libgl1-mesa-dev libopengl0 libglu1-mesa libglib2.0-0 libgomp1 \
      libx11-6 libxext6 libxi6 libxrender1 libxfixes3 libxxf86vm1 libxkbcommon0 \
      libsm6 libice6 libdbus-1-3 libxcursor1 libxinerama1 libxrandr2 libasound2 libfontconfig1 libfreetype6 && \
    rm -rf /var/lib/apt/lists/* && rm -f /etc/ssh/ssh_host_* && \
    locale-gen en_US.UTF-8 && \
    /usr/bin/python3.10 -m venv /opt/room/bootstrap && \
    /opt/room/bootstrap/bin/python -m pip --isolated install --no-cache-dir --index-url https://pypi.org/simple uv==0.9.26

